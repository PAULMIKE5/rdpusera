{
  "name": "globalrdp-hub",
  "version": "1.0.0",
  "description": "Global RDP and VPS marketplace with PostgreSQL billing and durable provisioning",
  "main": "index.js",
  "scripts": {
    "dev": "node --import tsx scripts/check-env.ts && next dev",
    "build": "prisma generate && next build --webpack",
    "start": "node --import tsx scripts/check-env.ts && next start",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "worker": "node --import tsx scripts/worker.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node --import tsx prisma/seed.ts",
    "test:integration": "node --import tsx --test tests/database.integration.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.5",
    "jose": "^6.2.12",
    "lucide-react": "^1.52.0",
    "next": "^16.3.8",
    "prisma": "^6.19.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "stripe": "^23.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "private": true,
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
